# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit .env (đã có trong .gitignore).

# API key tạo tại: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chưa verify domain riêng thì bắt buộc phải dùng địa chỉ mặc định này
MAIL_FROM=onboarding@resend.dev

# Chưa verify domain: BẮT BUỘC phải là email bạn dùng để đăng ký tài khoản Resend
# Đã verify domain: điền email bất kỳ bạn muốn nhận tin
MAIL_TO=example@gmail.com

# Origin của website được phép gọi API, cách nhau bằng dấu phẩy
ALLOWED_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

PORT=3001